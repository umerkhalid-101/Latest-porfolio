{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/salams-casestudy",
      "destination": "/salams-casestudy.html"
    },
    {
      "source": "/salams-casestudy/",
      "destination": "/salams-casestudy.html"
    },
    {
      "source": "/unita-casestudy",
      "destination": "/unita-casestudy.html"
    },
    {
      "source": "/unita-casestudy/",
      "destination": "/unita-casestudy.html"
    },
    {
      "source": "/mblm-casestudy",
      "destination": "/mblm-casestudy.html"
    },
    {
      "source": "/mblm-casestudy/",
      "destination": "/mblm-casestudy.html"
    },
    {
      "source": "/zewards-casestudy",
      "destination": "/zewards-casestudy.html"
    },
    {
      "source": "/zewards-casestudy/",
      "destination": "/zewards-casestudy.html"
    },
    {
      "source": "/zewst-casestudy",
      "destination": "/zewards-casestudy.html"
    },
    {
      "source": "/juno-casestudy",
      "destination": "/juno-casestudy.html"
    },
    {
      "source": "/juno-casestudy/",
      "destination": "/juno-casestudy.html"
    },
    {
      "source": "/snapflow-casestudy",
      "destination": "/snapflow-casestudy.html"
    },
    {
      "source": "/snapflow-casestudy/",
      "destination": "/snapflow-casestudy.html"
    },
    {
      "source": "/docsalot-casestudy",
      "destination": "/docsalot-casestudy.html"
    },
    {
      "source": "/docsalot-casestudy/",
      "destination": "/docsalot-casestudy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/folionomics-casestudy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/folionomics-casestudy/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/vara-casestudy",
      "destination": "/mblm-casestudy",
      "permanent": true
    },
    {
      "source": "/vara-casestudy/",
      "destination": "/mblm-casestudy",
      "permanent": true
    }
  ]
}
